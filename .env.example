# 365 Flow Watcher configuration.
# Reference: docs/configuration.md · setup steps: docs/setup/

# --- Demo ------------------------------------------------------------------
# true = no sign-in, seeded fake tenant. Everything below is ignored.
DEMO_MODE=false

# --- Required for live mode ------------------------------------------------
# Entra admin center > Overview > Tenant ID
AZURE_TENANT_ID=
# App registrations > your app > Overview > Application (client) ID
AZURE_CLIENT_ID=
# Public URL of this app. Must match the SPA redirect URI in the app registration.
APP_URL=http://localhost:3000
# Power Platform admin center > Manage > Environments > your environment > Environment ID
POWER_PLATFORM_ENVIRONMENT_ID=

# --- Optional ----------------------------------------------------------------
# Comma separated UPNs. Show only flows owned by these accounts.
# Empty = every flow in the environment.
WATCHED_FLOW_ACCOUNTS=
# Who may open the dashboard. Empty = anyone who can sign in to the app registration.
DASHBOARD_USERS=
# Who may grant/revoke flow access and preview another account's flows.
ACCESS_MANAGERS=
# Who may preview another account's flows. Empty = same as ACCESS_MANAGERS.
PREVIEW_MANAGERS=
# Grant/revoke is a write operation in your tenant. Off unless you opt in.
ENABLE_GRANT_ACCESS=false
